{
  "schema_version": "1.0",
  "topic": "Multiplexer (MUX) - Research Theme 7",
  "description": "Cấu trúc JSON output dự kiến cho hệ thống phân tích và mô phỏng mạch MUX",

  "input_schema": {
    "mux_type": {
      "type": "string",
      "description": "Loại MUX đang phân tích",
      "example": "4-to-1",
      "allowed_values": ["2-to-1", "4-to-1", "8-to-1"]
    },
    "select_lines": {
      "type": "object",
      "description": "Giá trị các đường chọn",
      "properties": {
        "S0": { "type": "integer", "allowed_values": [0, 1] },
        "S1": { "type": "integer", "allowed_values": [0, 1] }
      },
      "example": { "S1": 0, "S0": 1 }
    },
    "data_inputs": {
      "type": "object",
      "description": "Giá trị các ngõ vào dữ liệu",
      "properties": {
        "D0": { "type": "integer", "allowed_values": [0, 1] },
        "D1": { "type": "integer", "allowed_values": [0, 1] },
        "D2": { "type": "integer", "allowed_values": [0, 1] },
        "D3": { "type": "integer", "allowed_values": [0, 1] }
      },
      "example": { "D0": 1, "D1": 0, "D2": 1, "D3": 0 }
    }
  },

  "output_schema": {
    "selected_input": {
      "type": "string",
      "description": "Ngõ vào nào được chọn dựa trên select lines",
      "example": "D1"
    },
    "output_value": {
      "type": "integer",
      "description": "Giá trị ngõ ra Y",
      "allowed_values": [0, 1],
      "example": 0
    },
    "boolean_expression": {
      "type": "string",
      "description": "Biểu thức Boolean tổng quát của MUX",
      "example": "Y = (S1'·S0'·D0) + (S1'·S0·D1) + (S1·S0'·D2) + (S1·S0·D3)"
    },
    "truth_table": {
      "type": "array",
      "description": "Bảng chân trị đầy đủ của mạch",
      "items": {
        "S1": "integer",
        "S0": "integer",
        "selected_input": "string",
        "Y": "integer"
      },
      "example": [
        { "S1": 0, "S0": 0, "selected_input": "D0", "Y": "D0" },
        { "S1": 0, "S0": 1, "selected_input": "D1", "Y": "D1" },
        { "S1": 1, "S0": 0, "selected_input": "D2", "Y": "D2" },
        { "S1": 1, "S0": 1, "selected_input": "D3", "Y": "D3" }
      ]
    },
    "explanation": {
      "type": "string",
      "description": "Giải thích vì sao ngõ vào đó được chọn",
      "example": "S1=0, S0=1 nên MUX chọn kênh D1. Giá trị D1=0, vì vậy ngõ ra Y=0."
    },
    "application_note": {
      "type": "string",
      "description": "Ghi chú về ứng dụng thực tế liên quan đến cấu hình này",
      "example": "Cấu hình này có thể dùng để chọn dữ liệu từ kênh 1 trong bus dữ liệu 4 nguồn."
    }
  }
}
